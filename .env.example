# ==============================================================================
# SlurmRay Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# Do NOT commit the .env file to version control.

# --- Desi Server Credentials (Standalone Server) ---
DESI_USERNAME=your_desi_username
DESI_PASSWORD=your_desi_password
# DESI_PORT=22

# --- Curnagl Cluster Credentials (Slurm Cluster) ---
CURNAGL_USERNAME=your_curnagl_username
CURNAGL_PASSWORD=your_curnagl_password
# CURNAGL_PORT=22
